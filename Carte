import java.util.HashMap;
import java.util.Map;

public class Carte {
    private String nom;
    private largeur ;
    private hauteur ;
    private TreeSet<Zone> zones;

    public Carte(String nom,int largeur,int hauteur) {
        this.nom = nom;
        this.zones = new Treeset<>();
    }
    public void ajouterZone(Zone zone ){
        int x = zone.getPosition().getX();
        int y = zone.getPosition().getY();
     }
    // verifier si la pos est dans la carte 
     if (x<0|| x>=largeur || y<0|| y>=hauteur){
            throw new IllegalArgumentException("position hors carte ");
}
         
      if (!zones.add(zone)){
          throw new IllegalArgumentException ("Position deja occupe ");
}
     public void afficherCarte() {
        System.out.println(zone.getNom() + " " + zone.getPosition());

       
    }

    public Treeset<Zone> getZones() {
        return zones;
    }

}
