package tp1;

public class main{
     Thread t1 = new Thread(mission1);
     Thread t2 = new Thread(mission2);
     Thread t3 = new Thread(mission3);

     t1.start(); // lance chaque mission dans un thread independant 
     t2.start();
     t3.start();

    try {
       t1.join();// attend que les  missions soient terminees 
       t2.join();
       t3.join();
    } catch (InterruptedException e) {
      Thread.currentThread().interrupt();
}

}
