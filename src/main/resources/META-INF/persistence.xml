<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="agencePU">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>

        <class>tp1.RapportMission</class>

        <properties>
            <property name="jakarta.persistence.jdbc.driver" value="org.h2.Driver"/>
            <!-- Base H2 dans un fichier, dans le dossier data/ du projet (comme dans le sujet) -->
            <property name="jakarta.persistence.jdbc.url" value="jdbc:h2:./data/astro"/>
            <property name="jakarta.persistence.jdbc.user" value="sa"/>
            <property name="jakarta.persistence.jdbc.password" value=""/>

            <!-- Cree / met a jour la table automatiquement -->
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <!-- false : evite d'afficher le SQL au milieu de la demo -->
            <property name="hibernate.show_sql" value="false"/>
        </properties>
    </persistence-unit>

</persistence>